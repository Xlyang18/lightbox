{
  "name": "lightbox-photo-batch",
  "productName": "光匣",
  "version": "1.1.0",
  "description": "光匣 Lightbox — macOS 摄影集发布台账：多级文件夹预览选片、平台标记、批次打包归档、漏发检查",
  "author": "Xlyang",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.cjs",
    "dist": "vite build && electron-builder --mac dmg --arm64 --config.afterSign=scripts/after-sign.cjs",
    "dist:dir": "vite build && electron-builder --mac dir --arm64 --config.afterSign=scripts/after-sign.cjs",
    "start": "electron .",
    "e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.lightbox.app",
    "productName": "光匣",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "src/lib/*.mjs",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "光匣",
      "iconSize": 100,
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "光匣-${version}-${arch}.dmg"
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}